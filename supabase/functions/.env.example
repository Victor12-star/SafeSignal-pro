# SafeSignal server-side SMS provider configuration.
# Never commit real values. Set production values with Supabase Edge Function secrets.
SMS_DISPATCH_SECRET=replace-with-long-random-secret
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-secret
TWILIO_STATUS_CALLBACK_URL=https://YOUR_PROJECT.supabase.co/functions/v1/twilio-status-callback

# Prefer a Messaging Service for production routing. If omitted, configure TWILIO_FROM_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
